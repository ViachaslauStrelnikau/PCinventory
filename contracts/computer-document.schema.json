{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pcinventory.invalid/contracts/v1/computer-document.schema.json",
  "title": "PCinventory computer record v1",
  "type": "object",
  "unevaluatedProperties": false,
  "allOf": [
    {
      "$ref": "shared.schema.json#/$defs/hardware"
    },
    {
      "$ref": "shared.schema.json#/$defs/computerAssignment"
    }
  ],
  "required": [
    "deviceId",
    "lastReportId",
    "lastInventoryAt",
    "assignmentUpdatedAt",
    "assignmentUpdatedBy"
  ],
  "properties": {
    "deviceId": {
      "$ref": "shared.schema.json#/$defs/deviceId"
    },
    "status": {
      "enum": [
        "ACTIVE",
        "RETIRED"
      ],
      "default": "ACTIVE"
    },
    "lastReportId": {
      "anyOf": [{ "$ref": "shared.schema.json#/$defs/uuid" }, { "type": "null" }]
    },
    "lastInventoryAt": {
      "anyOf": [{ "$ref": "shared.schema.json#/$defs/timestamp" }, { "type": "null" }]
    },
    "assignmentUpdatedAt": {
      "$ref": "shared.schema.json#/$defs/timestamp"
    },
    "assignmentUpdatedBy": {
      "$ref": "shared.schema.json#/$defs/uid"
    }
  },
  "if": {
    "required": ["identitySource"],
    "properties": { "identitySource": { "const": "MANUAL" } }
  },
  "then": {
    "required": ["status"],
    "properties": {
      "status": true,
      "agentVersion": { "const": "manual" },
      "lastReportId": { "type": "null" },
      "lastInventoryAt": { "type": "null" }
    }
  },
  "else": {
    "properties": {
      "lastReportId": { "$ref": "shared.schema.json#/$defs/uuid" },
      "lastInventoryAt": { "$ref": "shared.schema.json#/$defs/timestamp" }
    }
  }
}
